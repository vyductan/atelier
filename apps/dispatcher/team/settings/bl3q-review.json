{
  "enabledPlugins": {
    "vercel@claude-plugins-official": false,
    "plugin-dev@claude-plugins-official": false,
    "supabase@claude-plugins-official": false
  },
  "permissions": {
    "additionalDirectories": [
      "~/Developer/g-bots/bl3q-agent",
      "~/Developer/g-bots/bl3q/.state",
      "~/Developer/g-bots/bl3q/shots"
    ],
    "allow": [
      "Read(~/Developer/g-bots/bl3q-agent/**)",
      "Read(~/Developer/g-bots/bl3q/.state/**)",
      "Read(~/Developer/g-bots/bl3q/shots/**)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(*git push*)",
      "Bash(git remote:*)",
      "Bash(git merge:*)",
      "Bash(git worktree:*)",
      "Bash(git checkout main:*)",
      "Bash(git switch main:*)",
      "Bash(git branch -f:*)",
      "Bash(git branch -D:*)",
      "Bash(git update-ref:*)",
      "Bash(git tag:*)",
      "Bash(gh:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(git commit:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Edit(~/Developer/**)",
      "Write(~/Developer/**)",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "mcp__agents__vm_exec",
      "mcp__plugin_vercel_vercel",
      "mcp__plugin_supabase_supabase",
      "mcp__vyductan-tasks",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.netrc)",
      "Read(~/.claude/**)",
      "Read(~/.atelier/**)",
      "Read(~/.cloudflared/**)",
      "Read(~/Library/**)",
      "Read(//Library/Application Support/com.cloudflare.cloudflared/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(~/.config/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.mcp.json)",
      "Edit(~/.bl3q-team/lead)",
      "Edit(~/.bl3q-team/lead/**)",
      "Edit(~/.bl3q-team/baseline)",
      "Edit(~/.bl3q-team/baseline/**)",
      "Edit(~/.bl3q-team/gate.log)",
      "Edit(~/.bl3q-team/gate.log/**)",
      "Edit(~/.bl3q-team/gate.lock)",
      "Edit(~/.bl3q-team/gate.lock/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": [],
    "filesystem": {
      "allowWrite": [
        "~/.cache/uv",
        "~/.bl3q-team/agent-state",
        "~/.bl3q-team/agent-reports",
        "~/.bl3q-team/agent-shots",
        "~/.bl3q-team/agent-debug"
      ],
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.gnupg",
        "~/.netrc",
        "~/.atelier",
        "~/.cloudflared",
        "~/Library",
        "~/.claude",
        "~/.config"
      ],
      "allowRead": [
        "~/.config/git"
      ],
      "denyWrite": [
        "~/.bl3q-team/review/verdicts",
        "~/.bl3q-team/review/.claude",
        "~/.bl3q-team/baseline"
      ]
    },
    "network": {
      "allowedDomains": [
        "localhost",
        "127.0.0.1"
      ],
      "allowLocalBinding": true
    }
  }
}
