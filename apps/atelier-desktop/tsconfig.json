{
  "extends": "@acme/tsconfig/base.json",
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "react", "react-dom"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Path aliases */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "~/*": ["./src/*"],
      "@acme/ui/components/*": ["../../@acme/ui/src/components/*"],
      "@acme/ui/shadcn/*": ["../../@acme/ui/src/shadcn/*"],
      "@acme/ui/lib/*": ["../../@acme/ui/src/lib/*"],
      "@acme/ui/icons": ["../../@acme/ui/src/icons/index.tsx"],
      "@acme/ui/icons/*": ["../../@acme/ui/src/icons/*"],
      "@acme/ui/src/*": ["../../@acme/ui/src/*"],
      "@acme/ui/*": ["../../@acme/ui/src/*"]
    }
  },
  "include": ["src", "readme.docs-test.ts", "eslint.config.ts"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
