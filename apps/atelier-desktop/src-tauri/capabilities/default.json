{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability",
  "windows": ["*"],
  "permissions": [
    "core:default",
    "shell:default",
    "dialog:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "rsync",
          "cmd": "rsync",
          "args": true
        },
        {
          "name": "stat",
          "cmd": "stat",
          "args": true
        }
      ]
    }
  ]
}
