{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "Atelier",
  "version": "0.1.0",
  "identifier": "dev.vyductan.atelier",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "publisher": "vyductan",
    "copyright": "Copyright (c) 2026 vyductan",
    "category": "DeveloperTool",
    "shortDescription": "Manage Claude Code sessions and conversations",
    "longDescription": "A desktop application for managing Claude Code sessions and conversations. View, search, and delete sessions with a native macOS interface.",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "exceptionDomain": ""
    }
  },
  "app": {
    "windows": [
      {
        "title": "Atelier",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
