{
  "$schema": "https://turborepo.org/schema.json",
  "ui": "tui",
  "tasks": {
    "topo": {
      "dependsOn": ["^topo"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".cache/tsbuildinfo.json", "dist/**"]
    },
    "dev": {
      "dependsOn": ["^dev"],
      "cache": false,
      "persistent": false
    },
    "format": {
      "outputs": [".cache/.prettiercache"],
      "outputLogs": "new-only"
    },
    "lint": {
      "dependsOn": ["^topo", "^build"],
      "outputs": [".cache/.eslintcache"]
    },
    "typecheck": {
      "dependsOn": ["^topo", "^build"],
      "outputs": [".cache/tsbuildinfo.json"]
    },
    "clean": {
      "cache": false
    },
    "//#clean": {
      "cache": false
    },
    "push": {
      "cache": false,
      "interactive": true
    },
    "studio": {
      "cache": false,
      "persistent": true
    },
    "atelier:dev": {
      "cache": false,
      "persistent": true
    },
    "aiprovider:dev": {
      "cache": false,
      "persistent": true
    }
  },
  "globalEnv": [
    "AUTH_SECRET",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "GOOGLE_APP_PASSWORD",
    "POSTGRES_URL",
    "POSTGRES_URL_NON_POOLING",
    "POSTGRES_URL_NO_SSL",
    "POSTGRES_PRISMA_URL",
    "POSTGRES_USER",
    "POSTGRES_HOST",
    "POSTGRES_PASSWORD",
    "POSTGRES_DATABASE",
    "PORT",
    "REDIS_URL",
    "RESEND_API_KEY",
    "SUPABASE_URL",
    "SUPABASE_ANON_KEY",
    "SUPABASE_SERVICE_ROLE_KEY",
    "SUPABASE_DATABASE_URL",
    "OPENAI_API_KEY",
    "OPENROUTER_API_KEY",
    "BLOB_READ_WRITE_TOKEN",
    "NOTION_TOKEN",
    "HF_ACCESS_TOKEN",
    "GITHUB_REPO_CLONE_TOKEN",
    "HASURA_PROJECT_ENDPOINT",
    "HASURA_ADMIN_SECRET",
    "FIXIE_URL",
    "COINGECKO_API_KEY",
    "NTFY_TOPIC",
    "NTFY_SERVER_URL",
    "BINANCE_API_KEY",
    "BINANCE_API_SECRET",
    "BINANCE_TESTNET_API_KEY",
    "BINANCE_TESTNET_API_SECRET",
    "BINANCE_TRADE_API_KEY",
    "BINANCE_TRADE_API_SECRET",
    "BINANCE_USE_TESTNET",
    "ACTION_SECRET_TOKEN"
  ],
  "globalPassThroughEnv": [
    "NODE_ENV",
    "CI",
    "VERCEL",
    "VERCEL_ENV",
    "VERCEL_URL",
    "npm_lifecycle_event",
    "COREPACK_HOME",
    "ENABLE_EXPERIMENTAL_COREPACK",
    "TURBO_TELEMETRY_DISABLED"
  ]
}
